# Local Development Environment Variables
# Copy this to .env for local development

# ===========================================
# DEVELOPMENT MODE
# ===========================================
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ===========================================
# EMAIL CONFIGURATION (FOR TESTING)
# ===========================================
# Use your Gmail credentials for testing
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-16-character-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
USE_TLS=true

# ===========================================
# UPTIMEROBOT CONFIGURATION (LOCAL TESTING)
# ===========================================
# For local testing - use a simple secret
UPTIMEROBOT_SECRET=local-development-secret-key

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Local SQLite database
DATABASE_PATH=app_data.db

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=DEBUG

# ===========================================
# SCRAPING CONFIGURATION (DEVELOPMENT)
# ===========================================
# Limit items for faster testing
MAX_ITEMS_PER_SEARCH=5
SCRAPE_TIMEOUT=30
