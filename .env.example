# Environment Variables for UptimeRobot + Shared Hosting Setup
# Copy this to .env and update with your actual values

# ===========================================
# EMAIL CONFIGURATION (REQUIRED)
# ===========================================
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-16-character-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
USE_TLS=true

# ===========================================
# UPTIMEROBOT CONFIGURATION (REQUIRED)
# ===========================================
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
UPTIMEROBOT_SECRET=your-secret-key-here-change-this

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_PATH=app_data.db

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum items to scrape per search term
MAX_ITEMS_PER_SEARCH=20

# Scraper timeout in seconds
SCRAPE_TIMEOUT=60
